{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cpu-specs-api",
	"main": "src/worker.js",
	"compatibility_date": "2026-05-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"AMD_REQUEST_INTERVAL_MS": "1000",
		"AMD_MAX_RETRIES": "2",
		"INTEL_SYNC_LIMIT": "4",
		"RAPIDAPI_PROXY_SECRET": "67e22940-5522-11f1-a7bd-019d2b7d43ab"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"r2_buckets": [
		{
			"binding": "CPU_DATA",
			"bucket_name": "cpu-specs-data"
		}
	]
}