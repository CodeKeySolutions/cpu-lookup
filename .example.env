# Local API server port.
PORT=3001

# AMD refreshes fetch three specification pages and space requests by default.
AMD_REQUEST_INTERVAL_MS=1000
AMD_MAX_RETRIES=2
INTEL_CPU_DATASET_PATH=./data/cpus/intel.json
AMD_CPU_DATASET_PATH=./data/cpus/amd.json

# Incremental Intel sync: discover new SKUs and add four every five minutes.
INTEL_SYNC_INTERVAL_MS=300000
INTEL_SYNC_LIMIT=4

# Optional: require requests to API routes to be verified RapidAPI proxy traffic.
RAPIDAPI_PROXY_SECRET=
